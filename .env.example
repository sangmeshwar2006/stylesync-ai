# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Public Razorpay key ID used by the browser checkout (never put the secret here).
VITE_RAZORPAY_KEY_ID="rzp_test_your_key_id"

# Server-only credentials used by the FastAPI payment API.
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_test_key_secret"

# Optional URL for Vite's /api proxy when the FastAPI service is not on localhost:8000.
# API_PROXY_TARGET="http://127.0.0.1:8000"
