# GEMINI_API_KEY: Server-side key used only by the FastAPI service.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
# Optional model override; defaults to gemini-2.5-flash.
GEMINI_MODEL="gemini-2.5-flash"

# Public Razorpay key ID used by browser checkout (never put the secret here).
VITE_RAZORPAY_KEY_ID="rzp_test_your_key_id"

# Server-only credentials used by the FastAPI payment API.
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_test_key_secret"

# Optional URL for Vite's /api proxy when FastAPI is not on localhost:8000.
# API_PROXY_TARGET="http://127.0.0.1:8000"
